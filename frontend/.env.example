# 前端只请求相对路径 /api，禁止写成完整后端 URL（会触发 CORS）
VITE_API_BASE_URL=/api
# 仅给 Vite 开发代理使用，默认 Agent 后端 8099；用户验收改为 http://localhost:8003
VITE_BACKEND_PROXY_TARGET=http://localhost:8099
# true 时走 frontend/src/mocks。联调/真接口验收改为 false 后必须重启 Vite
VITE_USE_MOCK=true
# 高德 JS API，仅 .env 填真实值；空则后续地图槽显示「地图未配置」
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=
