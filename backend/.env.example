# 调试日志
debug=true
# PyCore 要求；本期无会话签名用途
secret_key=change-me
# 后端监听
host=127.0.0.1
port=8099
# CORS：Agent 5199、用户验收 5175，以及后端 8099/8003
cors_origins=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175","http://localhost:8099","http://127.0.0.1:8099","http://localhost:8003","http://127.0.0.1:8003"]
# SQLite，相对 backend/ 目录；启动时解析为绝对路径并建父目录
database_path=data/Travel_Helper.db
# DeepSeek Chat Completions（EXT-001）；密钥只写本地 .env
deepseek_api_key=
deepseek_base_url=https://api.deepseek.com
deepseek_model=deepseek-flash
# 百炼千问 OpenAI 兼容（EXT-002）；本任务问诊不调用
qwen_api_key=
qwen_base_url=
qwen_model=qwen-plus
# D-007 A：Coco 问诊关思考，行程设计开思考
manager_thinking_enabled=false
itinerary_thinking_enabled=true
llm_timeout_seconds=60
llm_max_retries=1
# 高德 Web 服务；本任务不调用
amap_web_key=
amap_timeout_seconds=10
planning_timeout_seconds=180
max_tool_iterations_research=8
max_tool_iterations_itinerary=12
walk_threshold_m=1200
manager_history_limit=20
intake_max_followups=2
